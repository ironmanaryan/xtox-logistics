{
  "736": { "hi": "एक पार्टनर,", "kn": "ಒಬ್ಬ ಪಾಲುದಾರ," },
  "449": { "hi": "हम फ़ोन उठाते हैं। हम जवाब देते हैं।", "kn": "ನಾವು ಕರೆ ಸ್ವೀಕರಿಸುತ್ತೇವೆ. ನಾವು ಉತ್ತರಿಸುತ್ತೇವೆ." },
  "602": { "hi": "लॉजिस्टिक्स नोट्स।", "kn": "ಲಾಜಿಸ್ಟಿಕ್ಸ್ ಟಿಪ್ಪಣಿಗಳು." },
  "826": { "hi": "सवाल,", "kn": "ಪ್ರಶ್ನೆಗಳು," },
  "860": { "hi": "जवाब।", "kn": "ಉತ್ತರಗಳು." },
  "277": { "hi": "भारत के कामकाजी शहरों के बीच शिफ्टिंग।", "kn": "ಭಾರತದ ಕೆಲಸದ ನಗರಗಳ ನಡುವೆ ಸ್ಥಳಾಂತರ." }
