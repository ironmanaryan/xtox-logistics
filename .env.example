# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase (required for leads, leads admin, existing features) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin password for /admin and /admin/leads ----
ADMIN_PASSWORD=

# ---- Canonical public origin (no trailing slash) ----
NEXT_PUBLIC_SITE_URL=https://xtoxlogistics.vercel.app

# ---- Feature flags (leave false until the feature is real) ----
NEXT_PUBLIC_FEATURE_TRACK=false
NEXT_PUBLIC_FEATURE_LOGIN=false
NEXT_PUBLIC_FEATURE_BADGES=false

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Lead notifications (all optional) ----
# Owner alert email via Resend
RESEND_API_KEY=
LEAD_FROM_EMAIL=bookings@yourdomain.com
LEAD_NOTIFY_EMAIL=owner@yourdomain.com
# Owner alert via Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
